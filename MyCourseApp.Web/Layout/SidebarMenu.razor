@* SidebarMenu.razor *@
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@using Blazored.LocalStorage
@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container-fluid">
        <button class="navbar-toggler me-2" type="button" @onclick="ToggleSidebar">
            <span class="navbar-toggler-icon"></span>
        </button>
        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-mortarboard-fill me-2"></i> MyCourseApp
        </a>

        <div class="d-flex align-items-center">
            <div class="dropdown">
                <button class="btn btn-outline-light dropdown-toggle" type="button"
                        @onclick="ToggleUserDropdown">
                    <i class="bi bi-person-circle me-1"></i>
                    <span class="d-none d-md-inline">الحساب</span>
                </button>
                @if (showUserDropdown)
                {
                    <div class="dropdown-menu dropdown-menu-end show">
                        <a class="dropdown-item" href="/profile">
                            <i class="bi bi-person me-2"></i> الملف الشخصي
                        </a>
                        <a class="dropdown-item" href="/settings">
                            <i class="bi bi-gear me-2"></i> الإعدادات
                        </a>
                        <div class="dropdown-divider"></div>
                        <button class="dropdown-item text-danger" @onclick="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> تسجيل الخروج
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</nav>

<div class="sidebar-wrapper @(sidebarCollapsed ? "collapsed" : "")" @onclick:stopPropagation>
    <div class="sidebar-header d-flex justify-content-between align-items-center p-3">
        <h5 class="mb-0 text-white" style="@(sidebarCollapsed ? "display: none;" : "")">
            <i class="bi bi-menu-button-wide me-2"></i> القائمة
        </h5>
        <button class="btn btn-sm btn-outline-light toggle-btn" @onclick="ToggleSidebar">
            <i class="bi @(sidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
        </button>
    </div>

    <div class="sidebar-menu">
        <NavLink class="sidebar-item" href="" Match="NavLinkMatch.All" ActiveClass="active">
            <i class="bi bi-house-door-fill"></i>
            <span class="menu-text">الصفحة الرئيسية</span>
        </NavLink>

        <NavLink class="sidebar-item" href="courses" ActiveClass="active">
            <i class="bi bi-book-fill"></i>
            <span class="menu-text">الدورات</span>
        </NavLink>

        <NavLink class="sidebar-item" href="teachers" ActiveClass="active">
            <i class="bi bi-person-badge-fill"></i>
            <span class="menu-text">الأساتذة</span>
        </NavLink>

        <NavLink class="sidebar-item" href="students" ActiveClass="active">
            <i class="bi bi-people-fill"></i>
            <span class="menu-text">الطلاب</span>
        </NavLink>

        <div class="sidebar-divider"></div>

        <NavLink class="sidebar-item" href="add-course" ActiveClass="active">
            <i class="bi bi-plus-circle"></i>
            <span class="menu-text">إضافة دورة</span>
        </NavLink>

        <div class="sidebar-divider mt-auto"></div>

        <button class="sidebar-item text-danger" @onclick="Logout">
            <i class="bi bi-box-arrow-right"></i>
            <span class="menu-text">تسجيل الخروج</span>
        </button>
    </div>
</div>

@code {
    private bool sidebarCollapsed = false;
    private bool showUserDropdown = false;
    private DotNetObjectReference<SidebarMenu>? objRef;

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
        LocalStorage.SetItemAsync("sidebarCollapsed", sidebarCollapsed);
    }

    private void ToggleUserDropdown()
    {
        showUserDropdown = !showUserDropdown;
    }

    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedState = await LocalStorage.GetItemAsync<bool>("sidebarCollapsed");
            if (savedState != sidebarCollapsed)
            {
                sidebarCollapsed = savedState;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}

<style>
    /* Keep all the same CSS styles from previous version */
    .sidebar-wrapper {
        position: fixed;
        top: 56px;
        left: 0;
        height: calc(100vh - 56px);
        width: 250px;
        background-color: #2c3e50;
        color: white;
        transition: all 0.3s;
        z-index: 1000;
        box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: column;
    }
    /* ... rest of the CSS ... */
</style>