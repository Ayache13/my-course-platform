@page "/teachers"
@inject TeacherService TeacherService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using MyCourseApp.Web.Models
@using MyCourseApp.Web.Services
@using System.Globalization

<div class="teachers-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="page-title mb-0">
            <i class="bi bi-person-badge me-2"></i> قائمة الأساتذة
        </h3>

        <div class="d-flex">
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="ابحث عن أستاذ..."
                       @bind="searchQuery" @bind:event="oninput" />
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">جار التحميل...</span>
            </div>
            <p class="mt-3">جاري تحميل بيانات الأساتذة...</p>
        </div>
    }
    else if (!filteredTeachers.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-person-x fs-1 text-muted mb-3"></i>
            <h5 class="mb-2">لا يوجد أساتذة</h5>
            <p class="text-muted">@(string.IsNullOrEmpty(searchQuery) ? "لا يوجد أساتذة مسجلين حالياً" : "لم يتم العثور على نتائج")</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var teacher in filteredTeachers)
            {
                <div class="col">
                    <div class="card h-100 teacher-card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">
                                @teacher.Courses?.Count دورة
                            </span>
                            <div class="rating">
                                <i class="bi bi-star-fill text-warning"></i>
                                <span>4.8</span>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <div class="teacher-avatar mb-3">
                                <i class="bi bi-person-circle fs-1"></i>
                            </div>
                            <h5 class="card-title">@teacher.FullName</h5>
                            @* <p class="card-text text-muted">@teacher.Specialization</p> *@
                            <p class="card-text text-muted">Specialization</p>

                            <div class="teacher-info mt-3">
                                <div class="d-flex align-items-center justify-content-center mb-2">
                                    <i class="bi bi-envelope me-2 text-primary"></i>
                                    <small>@teacher.Email</small>
                                </div>
                                <div class="d-flex align-items-center justify-content-center">
                                    <i class="bi bi-telephone me-2 text-primary"></i>
                                    @* <small>@teacher.PhoneNumber</small> *@
                                    <small>PhoneNumber</small>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-center">
                            <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => ViewTeacherDetails(teacher.Id)">
                                <i class="bi bi-eye me-1"></i> التفاصيل
                            </button>
                            <button class="btn btn-outline-success btn-sm" @onclick="() => ContactTeacher(teacher.Id)">
                                <i class="bi bi-chat-left-text me-1"></i> تواصل
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Teacher> teachers = new();
    private List<Teacher> filteredTeachers = new();
    private bool isLoading = true;
    private string searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachers();
    }

    private async Task LoadTeachers()
    {
        isLoading = true;
        try
        {
            teachers = (await TeacherService.GetAllTeachersAsync())?.ToList() ?? new List<Teacher>();
            FilterTeachers();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading teachers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterTeachers()
    {
        filteredTeachers = teachers.Where(t =>
            string.IsNullOrEmpty(searchQuery) ||
            t.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            t.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) /*||
            t.Specialization.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)*/
        ).ToList();
    }

    private void ViewTeacherDetails(int teacherId)
    {
        Navigation.NavigateTo($"/teacher/{teacherId}");
    }

    private async Task ContactTeacher(int teacherId)
    {
        // Implement contact functionality
        await JSRuntime.InvokeVoidAsync("alert", "سيتم فتح نموذج التواصل مع الأستاذ");
    }
}

<style>
    .teachers-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .page-title {
        color: #2c3e50;
        font-weight: 600;
    }

    .teacher-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border-radius: 10px;
        overflow: hidden;
        border: none;
    }

        .teacher-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1) !important;
        }

    .teacher-avatar {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        background-color: #f8f9fa;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
    }

    .teacher-info {
        background-color: #f8f9fa;
        padding: 0.75rem;
        border-radius: 8px;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
        font-weight: 500;
    }

    .rating {
        font-size: 0.9rem;
    }

    .empty-state {
        background-color: #f8f9fa;
        border-radius: 10px;
    }

    .btn-outline-primary {
        color: #0d6efd;
        border-color: #0d6efd;
    }

        .btn-outline-primary:hover {
            background-color: #0d6efd;
            color: white;
        }

    .btn-outline-success {
        color: #28a745;
        border-color: #28a745;
    }

        .btn-outline-success:hover {
            background-color: #28a745;
            color: white;
        }
</style>