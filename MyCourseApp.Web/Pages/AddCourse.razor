@page "/add-course"
@inject NavigationManager Navigation
@inject CourseService CourseService
@inject IJSRuntime JSRuntime
@using MyCourseApp.Shared.Dtos
@using MyCourseApp.Web.Services
@using System.ComponentModel.DataAnnotations

<div class="add-course-container">
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h3 class="card-title mb-0">
                <i class="bi bi-plus-circle me-2"></i> إضافة دورة جديدة
            </h3>
        </div>
        <div class="card-body">
            <EditForm Model="@course" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                <div class="mb-3">
                    <label for="title" class="form-label">عنوان الدورة</label>
                    <InputText id="title" class="form-control" @bind-Value="course.Title" />
                    <ValidationMessage For="@(() => course.Title)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">وصف الدورة</label>
                    <InputTextArea id="description" class="form-control" rows="4" @bind-Value="course.Description" />
                    <ValidationMessage For="@(() => course.Description)" class="text-danger small" />
                    <div class="form-text">وصف واضح ومفصل للدورة يساعد الطلاب على فهم المحتوى</div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="startDate" class="form-label">تاريخ البداية</label>
                        <InputDate id="startDate" class="form-control" @bind-Value="course.StartDate" />
                        <ValidationMessage For="@(() => course.StartDate)" class="text-danger small" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="endDate" class="form-label">تاريخ النهاية</label>
                        <InputDate id="endDate" class="form-control" @bind-Value="course.EndDate" />
                        <ValidationMessage For="@(() => course.EndDate)" class="text-danger small" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="rate" class="form-label">التقييم المبدئي (اختياري)</label>
                    <InputNumber id="rate" class="form-control" @bind-Value="course.Rate" min="0" max="5" step="0.1" />
                    <div class="form-text">يمكنك تحديد تقييم مبدئي للدورة من 0 إلى 5</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateBack">
                        <i class="bi bi-arrow-right me-1"></i> رجوع
                    </button>
                    <button type="submit" class="btn btn-success" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <i class="bi bi-check-circle me-1"></i> حفظ الدورة
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CourseDto course = new() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(1) };
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;

        try
        {
            await CourseService.AddCourseAsync(course);
            Navigation.NavigateTo("/teacher/my-courses");
        }
        catch (Exception ex)
        {
            // await JSRuntime.InvokeVoidAsync("showToast", "error", "خطأ", "فشل في إضافة الدورة: " + ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/teacher/my-courses");
    }
}

<style>
    .add-course-container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .card {
        border-radius: 10px;
        border: none;
    }

    .card-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        padding: 1.25rem;
    }

    .card-body {
        padding: 1.5rem;
    }

    .form-control {
        padding: 0.75rem;
        border-radius: 8px;
    }

    .btn-success {
        background-color: #28a745;
        border: none;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
    }

        .btn-success:hover {
            background-color: #218838;
        }

        .btn-success:disabled {
            background-color: #86b7fe;
        }

    .form-text {
        font-size: 0.875rem;
        color: #6c757d;
    }
</style>