@page "/course/{id:int}"
@inject CourseService CourseService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using MyCourseApp.Shared.Dtos
@using System.Globalization
@using MyCourseApp.Web.Services

<div class="course-details-container">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>حدث خطأ: @errorMessage</div>
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">جار التحميل...</span>
            </div>
            <p class="mt-3">جاري تحميل بيانات الدورة...</p>
        </div>
    }
    else if (course == null)
    {
        <div class="alert alert-warning text-center py-4">
            <i class="bi bi-exclamation-circle fs-4"></i>
            <h4 class="mt-2">لم يتم العثور على الدورة</h4>
            <p class="mb-0">الدورة المطلوبة غير موجودة أو قد تم حذفها</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-journal-bookmark me-2"></i> @course.Title
                    </h3>
                    <span class="badge @GetStatusBadgeClass(course)">
                        @GetStatusText(course)
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="mb-3">وصف الدورة</h5>
                        <p class="text-muted">@course.Description</p>

                        <div class="course-meta mt-4">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-calendar-event fs-5 text-primary me-3"></i>
                                        <div>
                                            <small class="text-muted">تاريخ البدء</small>
                                            <div class="fw-bold">@course.EndDate.ToString("dd MMMM yyyy", CultureInfo.GetCultureInfo("en-US"))</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-calendar-check fs-5 text-primary me-3"></i>
                                        <div>
                                            <small class="text-muted">تاريخ الانتهاء</small>
                                            <div class="fw-bold">@course.EndDate.ToString("dd MMMM yyyy", CultureInfo.GetCultureInfo("en-US"))</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-clock fs-5 text-primary me-3"></i>
                                        <div>
                                            <small class="text-muted">المدة</small>
                                            <div class="fw-bold">@((course.EndDate - course.StartDate).Days) أيام</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-star-fill fs-5 text-primary me-3"></i>
                                        <div>
                                            <small class="text-muted">التقييم</small>
                                            <div class="d-flex align-items-center">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= course.Rate ? "bi-star-fill" : "bi-star") text-warning"></i>
                                                }
                                                <span class="ms-2">(@course.Rate.ToString("0.0", CultureInfo.InvariantCulture))</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private CourseDto? course;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            course = await CourseService.GetCourseByIdAsync(id);
            if (course == null)
            {
                errorMessage = "لم يتم العثور على الدورة المطلوبة.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ: {ex.Message}";
            Console.Error.WriteLine($"Error loading course: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass(CourseDto course)
    {
        if (course.EndDate < DateTime.Now) return "bg-secondary";
        if (course.StartDate > DateTime.Now) return "bg-info";
        return "bg-success";
    }

    private string GetStatusText(CourseDto course)
    {
        if (course.EndDate < DateTime.Now) return "منتهية";
        if (course.StartDate > DateTime.Now) return "قادمة";
        return "نشطة";
    }

    private void GoBackToCourses()
    {
        Navigation.NavigateTo("/courses");
    }
}

<style>
    .course-details-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .card {
        border-radius: 10px;
        overflow: hidden;
    }

    .course-meta {
        background-color: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.35em 0.65em;
        font-weight: 500;
    }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
        padding: 0.75rem;
    }

    .btn-primary:hover {
        background-color: #0b5ed7;
    }
</style>