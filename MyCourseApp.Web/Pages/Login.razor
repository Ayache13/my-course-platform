@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject CustomAuthenticationStateProvider AuthProvider
@using MyCourseApp.Shared.Models
@using System.IdentityModel.Tokens.Jwt
@using MyCourseApp.Web.Services

<div class="auth-container">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-person-circle auth-icon"></i>
            <h3 class="auth-title">تسجيل الدخول إلى TutorLink</h3>
            <p class="text-muted">أدخل بياناتك للوصول إلى حسابك</p>
        </div>

        <EditForm Model="@loginRequest" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="email" class="form-label">البريد الإلكتروني</label>
                <InputText @bind-Value="loginRequest.Email" id="email"
                           class="form-control" placeholder="example@domain.com" />
                <ValidationMessage For="@(() => loginRequest.Email)" />
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">كلمة المرور</label>
                <div class="input-group">
                    <InputText @bind-Value="loginRequest.Password" id="password"
                               type="@(showPassword ? "text" : "password")"
                               class="form-control" placeholder="********" />
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="TogglePasswordVisibility">
                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => loginRequest.Password)" />
                <div class="text-end mt-2">
                    <a href="/forgot-password" class="small text-decoration-none">نسيت كلمة المرور؟</a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-exclamation-circle me-2"></i> @errorMessage
                </div>
            }

            <button type="submit" class="btn btn-primary w-100 py-2 mb-3" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                تسجيل الدخول
            </button>

            <div class="text-center">
                <p class="mb-0">
                    لا تملك حسابًا؟
                    <a href="/register" class="text-primary fw-bold text-decoration-none">إنشاء حساب جديد</a>
                </p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string? errorMessage;
    private bool isLoading = false;
    private bool showPassword = false;

    private async Task HandleLogin()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var response = await AuthService.LoginAsync(loginRequest);

            if (string.IsNullOrEmpty(response?.Token))
            {
                errorMessage = "بيانات الدخول غير صحيحة";
                isLoading = false;
                return;
            }

            // Save token securely
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "jwtToken", response.Token);

            // Notify authentication state change
            AuthProvider.NotifyUserAuthenticationChanged();

            // Extract role and redirect
            var role = AuthService.GetRoleFromToken(response.Token);
            var redirectPath = role switch
            {
                "Student" => "/student/dashboard",
                "Teacher" => "/teacher/dashboard",
                "Admin" => "/admin/dashboard",
                _ => throw new Exception("دور المستخدم غير معروف")
            };

            Navigation.NavigateTo(redirectPath, forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ: {ex.Message}";
            isLoading = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }
}

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f8f9fa;
        padding: 20px;
    }

    .auth-card {
        background: white;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 450px;
    }

    .auth-icon {
        font-size: 3rem;
        color: #0d6efd;
        margin-bottom: 1rem;
    }

    .auth-title {
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .form-control {
        padding: 0.75rem 1rem;
        border-radius: 8px;
    }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
        border-radius: 8px;
        padding: 0.75rem;
        font-weight: 500;
        transition: all 0.3s;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
        }

        .btn-primary:disabled {
            background-color: #86b7fe;
        }

    .input-group .btn {
        border-radius: 0 8px 8px 0;
    }
</style>